{
  "name": "fdgmaker",
  "compatibility_date": "2025-10-01",
  "main": "src/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/pt-br", "/en", "/es", "/de", "/zh-cn", "/fr", "/ja", "/it", "/ko", "/pl", "/ru", "/cs", "/nl", "/tr", "/zh-tw", "/pt-br/*", "/en/*", "/es/*", "/de/*", "/zh-cn/*", "/fr/*", "/ja/*", "/it/*", "/ko/*", "/pl/*", "/ru/*", "/cs/*", "/nl/*", "/tr/*", "/zh-tw/*"]
  },
  "send_email": [{ "name": "MAIL" }]
}
